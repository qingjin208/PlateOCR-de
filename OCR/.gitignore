# Finder
.DS_Store

# Xcode - User files
xcuserdata/

**/*.xcodeproj/project.xcworkspace/*
!**/*.xcodeproj/project.xcworkspace/xcshareddata

**/*.xcodeproj/project.xcworkspace/xcshareddata/*
!**/*.xcodeproj/project.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# Compiled Core ML models (large, generated at build time)
**/*.mlmodelc/

# Local Python environments and generated bytecode
.venv/
__pycache__/
*.pyc

# CocoaPods — regenerated locally with `pod install` (never commit these)
Pods/
LicensePlateOCR.xcworkspace/

# Xcode project backups written by Scripts/retarget_to_coreml.py
*.pbxproj.bak

# Core ML model generated on macOS by Scripts/export_pose_coreml.py
LicensePlateOCR/LicensePlateSDK/Resources/*.mlpackage
