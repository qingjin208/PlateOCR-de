platform :ios, '18.0'
target 'LicensePlateOCR' do
  pod 'onnxruntime-mobile-objc', '1.18.0'
end

post_install do |installer|
  # onnxruntime-mobile-c's podspec does not declare a deployment target, so
  # CocoaPods defaults it to iOS 12.0 — below the 13.0 minimum the binary
  # actually supports, which triggers the "supported range is 13.0 to 27.0"
  # warning on every pod install. Pin every pod target to the app's target.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '18.0'
    end
  end
end
