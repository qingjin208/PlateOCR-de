//
// SampleCode.xcconfig
//
// Shared build configuration for the License Plate OCR demo.
//

// NOTE: CocoaPods settings (framework/search paths for the onnxruntime-mobile-objc
// pod) are injected via the app TARGET's base configurations, which now point at
// Pods-LicensePlateOCR.debug/release.xcconfig directly (the standard CocoaPods
// wiring). This file remains the PROJECT-level base only; do not #include the Pods
// files here — a quoted #include with a space-containing path
// ("Target Support Files/...") resolves inconsistently across Xcode versions, and
// including both Debug and Release variants lets the last one silently override
// per-configuration settings (e.g. SWIFT_ACTIVE_COMPILATION_CONDITIONS).
// Paths are relative to this file (Configuration/ -> ../Pods/...).

// Set DEVELOPMENT_TEAM to your Personal Team ("衿青") in Xcode:
//   Signing & Capabilities -> Team -> 衿青 (Personal Team)
// Xcode writes the 10-character Team ID here automatically once selected.
DEVELOPMENT_TEAM = $(inherited)
